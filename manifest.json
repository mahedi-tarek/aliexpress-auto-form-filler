{
  "manifest_version": 3,
  "name": "Address Filler for AliExpress – Dropshipping Address Autofill",
  "version": "1.1.1",
  "description": "Paste any customer address into AliExpress checkout in one click. Autofills name, street, city, ZIP & phone for dropshipping orders.",
  "permissions": [
    "clipboardRead",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://*.aliexpress.com/*",
    "https://*.aliexpress.us/*",
    "https://tahjkdlttlxgqhoxjqxd.supabase.co/*",
    "https://address-filler-api.mhtareqarz.workers.dev/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Address Filler for AliExpress"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.aliexpress.com/*",
        "https://*.aliexpress.us/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_end"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "short_name": "Address Filler"
}
