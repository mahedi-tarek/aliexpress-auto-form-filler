{
  "name": "aliexpress-address-filler",
  "version": "1.1.0",
  "private": true,
  "scripts": {
    "build": "webpack --mode production",
    "dev": "webpack --mode development --watch",
    "secret:stripe": "npm --prefix backend run secret:stripe",
    "secret:webhook": "npm --prefix backend run secret:webhook",
    "secret:resend": "npm --prefix backend run secret:resend",
    "secret:supabase": "npm --prefix backend run secret:supabase",
    "test": "npm --prefix backend test",
    "package": "npm run build && rm -f store/address-filler-extension.zip && cd dist && zip -qr ../store/address-filler-extension.zip . -x '*.DS_Store'"
  },
  "devDependencies": {
    "copy-webpack-plugin": "^12.0.2",
    "dotenv": "^17.4.2",
    "webpack": "^5.97.0",
    "webpack-cli": "^6.0.0"
  }
}
